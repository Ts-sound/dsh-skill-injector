/temp/

# working plans stay local, not part of the published repo
/docs/plans/

# dsh-skill-injector build output is committed: installs run against lib/
# without a build step, so lib/index.js, lib/helpers.js, lib/client.js and
# are tracked on purpose. Source maps are not built.
node_modules/

# local pnpm store/state (sandboxed sessions redirect the user profile here)
/.pnpm-home/